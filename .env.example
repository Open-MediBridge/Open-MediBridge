# --- Whisper (speech-to-text) -------------------------------------------
# Any faster-whisper model id; large-v3-turbo is the default.
# Smaller/faster options: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3-turbo
# auto (cuda if available, else cpu) | cpu | cuda
WHISPER_DEVICE=auto
# auto (int8 on cpu, float16 on cuda) | int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=auto

# --- Embeddings (local, via fastembed/ONNX) -----------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Knowledge base (SQLite) --------------------------------------------
DB_PATH=data/open_medi.db
TOP_K=6

# --- LLM (any OpenAI-compatible endpoint) --------------------------------
# Default: local Ollama. Start it with:  ollama serve  (then: ollama pull llama3.2)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.2

# To use a hosted provider instead, comment the three lines above and
# uncomment one of these blocks:
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Z.ai:
#   LLM_BASE_URL=https://api.z.ai/api/paas/v4
#   LLM_API_KEY=...
#   LLM_MODEL=glm-4-flash
